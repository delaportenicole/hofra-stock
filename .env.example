# Supabase PostgreSQL
# Ve a https://supabase.com -> Project Settings -> Database -> Connection string
# Usa el formato "URI" y reemplaza [YOUR-PASSWORD] con tu password
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# JWT
JWT_SECRET=your-secret-key-min-32-characters-long
JWT_REFRESH_SECRET=your-refresh-secret-key-min-32-characters

# Cloudinary (opcional - para subir imagenes)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# App
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
